{
  "name": "survived",
  "version": "0.1.0",
  "description": "Measures how much AI-generated code in a git repository is still alive after 30/60/90 days, next to a human baseline",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "bin": {
    "survived": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentlane/survived.git"
  },
  "bugs": {
    "url": "https://github.com/agentlane/survived/issues"
  },
  "homepage": "https://github.com/agentlane/survived#readme"
}
